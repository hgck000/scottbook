{
  "name": "scottbook",
  "private": true,
  "version": "0.41.0",
  "type": "module",
  "scripts": {
    "audit:security": "node scripts/audit-security.mjs && node scripts/audit-runtime-licenses.mjs && npm audit --omit=dev --audit-level=high",
    "android:build:debug": "npm run android:sync && node scripts/build-android-debug.mjs",
    "android:build:release": "npm run android:sync && node scripts/build-android-release.mjs",
    "android:device:smoke": "node scripts/run-android-device-smoke.mjs",
    "android:sync": "npm run build:android:web && cap sync android && node scripts/verify-android-project.mjs",
    "android:upgrade:smoke": "node scripts/run-android-upgrade-smoke.mjs",
    "dev": "vite",
    "build": "npm run validate:content && tsc -b && vite build && npm run verify:release",
    "build:android:web": "npm run validate:content && tsc -b && vite build --mode native && node scripts/verify-android-web.mjs",
    "data:cvdict": "node scripts/build-cvdict-data.mjs",
    "data:han-viet": "node scripts/build-han-viet-data.mjs",
    "data:library": "node scripts/build-reading-library.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:list": "playwright test --list",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "validate:content": "node scripts/build-reading-library.mjs --check && vitest run src/content/builtInLibrary.test.ts",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "fflate": "^0.8.2",
    "pinyin-pro": "^3.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
